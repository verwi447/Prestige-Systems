NODE_ENV=production
PORT=5000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:ZMIEN_HASLO@localhost:5432/prestige_systems_hub
JWT_SECRET=WKLEJ_TUTAJ_DLUGI_LOSOWY_SEKRET
EMAIL_ENCRYPTION_KEY=WKLEJ_TUTAJ_DLUGI_LOSOWY_KLUCZ
# "loopback" gdy reverse proxy (np. Caddy) dziala na TYM SAMYM serwerze.
# Adres IP (np. 192.168.10.50) albo zakres CIDR (np. 192.168.10.0/24), gdy
# reverse proxy dziala na INNYM urzadzeniu w sieci lokalnej - w przeciwnym
# razie prawdziwy adres klienta (a wiec i GEO_ALLOWED_COUNTRIES) nie zadziala.
TRUST_PROXY=loopback
ALLOWED_ORIGINS=https://hub.twoja-domena.pl
# Opcjonalne: wlacza asystenta AI dla zgloszen serwisowych (analiza opisu i zdjec, Google Gemini).
# Bez klucza funkcja jest po prostu wylaczona. Darmowy klucz: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcjonalne: ogranicza dostep do panelu tylko z wybranych krajow (kody ISO 3166-1
# alpha-2, po przecinku, np. "PL,IT"). Adresy lokalne/sieci wewnetrznej zawsze maja
# dostep. Puste = wylaczone (domyslnie dla lokalnego developmentu).
GEO_ALLOWED_COUNTRIES=
