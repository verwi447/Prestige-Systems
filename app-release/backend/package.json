{
  "name": "aplikacja-ps-backend",
  "version": "1.0.1",
  "description": "Backend for CRM app",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src scripts test integration e2e playwright.config.js",
    "test": "node --test",
    "test:api": "node --test --test-concurrency=1 integration/apiAccess.integration.js",
    "test:e2e": "playwright test --config playwright.config.js",
    "check": "npm run lint && npm test",
    "check:full": "npm run check && npm run test:api",
    "service:install": "node service/install-service.cjs",
    "service:uninstall": "node service/uninstall-service.cjs",
    "db:setup": "node scripts/setupDatabase.js",
    "db:migrate": "node scripts/migrateDatabase.js",
    "db:status": "node scripts/migrationStatus.js",
    "admin:create": "node scripts/createAdmin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "node-windows": "^1.0.0-beta.8",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14"
  }
}
